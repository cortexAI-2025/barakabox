{
  "expo": {
    "name": "BarakaBox",
    "slug": "barakabox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A5C35"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ma.barakabox.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BarakaBox utilise votre position pour trouver des offres alimentaires à proximité.",
        "NSCameraUsageDescription": "BarakaBox utilise la caméra pour scanner les QR codes.",
        "NSPhotoLibraryUsageDescription": "BarakaBox a besoin d'accéder à vos photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#1A5C35"
      },
      "package": "ma.barakabox.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser BarakaBox à utiliser la caméra pour scanner les QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#1A5C35"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser BarakaBox à utiliser votre position pour trouver des offres à proximité."
        }
      ]
    ],
    "scheme": "barakabox",
    "extra": {}
  }
}
