{
  "expo": {
    "name": "BarakaBox",
    "slug": "barakabox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6B3C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ma.barakabox.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BarakaBox uses your location to find nearby food offers.",
        "NSCameraUsageDescription": "BarakaBox uses the camera to scan QR codes.",
        "NSPhotoLibraryUsageDescription": "BarakaBox needs access to your photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#1A6B3C"
      },
      "package": "ma.barakabox.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#1A6B3C"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow BarakaBox to use your location."
        }
      ]
    ],
    "scheme": "barakabox",
    "extra": {
      "API_URL": "http://localhost:3000/api/v1",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
